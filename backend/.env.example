# 이 파일을 복사해서 backend/.env 를 만들고 값을 채우세요. (.env는 커밋 금지)

# 가짜 응답 모드. 실제 LLM 호출하려면 false.
USE_FAKE_LLM=true

# 사용할 LLM provider: openai 또는 gemini (기본 gemini)
LLM_PROVIDER=gemini

# --- OpenAI (GPT) 사용 시 ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Gemini 사용 시 ---
GEMINI_API_KEY=

# --- GitHub 레포 목록 조회 프록시용 토큰 (선택, 있으면 rate limit 60→5000/h) ---
GITHUB_TOKEN=
